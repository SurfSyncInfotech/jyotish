    {
      "name": "1. Janam Kundli (Birth Chart)",
      "item": [
        {
          "name": "Get Birth Name & Namakshar (Syllables)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Your Name\",\n  \"gender\": \"male\",\n  \"date\": \"2005-08-31T12:00:00+05:30\",\n  \"latitude\": 28.6139,\n  \"longitude\": 77.2090\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/name",
              "host": ["{{baseUrl}}"],
              "path": ["api", "name"]
