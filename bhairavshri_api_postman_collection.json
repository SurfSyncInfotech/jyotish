    "description": "Official Postman Collection for Bhairavshri In-House Vedic Astrology Calculation & Prediction API (Approved Developer Implementation Specification v1.1 - SurfSync Infotech Pvt. Ltd.)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1/astrology",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "bhairavshri-api-key-2026",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System & Operations",
      "item": [
        {
          "name": "Health Check (GET /health)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Returns operational health and uptime. No sensitive user data."
          }
        },
        {
          "name": "Settings & Calculation Standards (GET /details/settings)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/details/settings",
              "host": ["{{baseUrl}}"],
              "path": ["details", "settings"]
            },
            "description": "Returns engine version, rules version, Lahiri (Chitrapaksha) Ayanamsa details, and supported profiles."
          }
        }
      ]
    },
    {
      "name": "2. Core Kundli Calculations",
      "item": [
        {
          "name": "Calculate Core Kundli (POST /kundli/calculate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request_id\": \"req-delhi-001\",\n  \"subject_ref\": \"client-ref-101\",\n  \"birth\": {\n    \"date\": \"1997-08-14\",\n    \"local_time\": \"09:35:00\",\n    \"place_name\": \"New Delhi, India\",\n    \"latitude\": 28.6139,\n    \"longitude\": 77.2090,\n    \"timezone\": \"Asia/Kolkata\"\n  },\n  \"language\": \"en\",\n  \"calculation_profile\": \"vedic-lahiri-v1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/kundli/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["kundli", "calculate"]
            },
            "description": "Computes Lagna, Janma Rashi, 9 Planets + Nodes (degrees, speed, retro, combust, dignity), 12 Whole-Sign Houses, and Nakshatra/Pada."
          }
        }
      ]
    },
