    {
      "name": "6. Validation & Security Checks",
      "item": [
        {
          "name": "Unauthorized Access Test (Expect 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"birth\": {\n    \"date\": \"2000-01-01\",\n    \"latitude\": 28.6139,\n    \"longitude\": 77.2090\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/kundli/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["kundli", "calculate"]
            },
            "description": "Verifies that requests missing the x-api-key header are rejected with 401 Unauthorized."
          }
        },
        {
          "name": "Invalid Latitude Test (Expect 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"birth\": {\n    \"date\": \"2000-01-01\",\n    \"local_time\": \"12:00:00\",\n    \"latitude\": 195.0,\n    \"longitude\": 77.2090\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/kundli/calculate",
              "host": ["{{baseUrl}}"],
              "path": ["kundli", "calculate"]
            },
            "description": "Verifies that out-of-range latitude values are rejected with 400 Bad Request (INVALID_BIRTH_INPUT)."
          }
        }
      ]
    }
